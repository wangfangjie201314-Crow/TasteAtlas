# --- Qloo (required) ---
# Hackathon key from the "API key request form" in the Qloo hackathon developer
# guide (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide).
# Valid ONLY against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Historical LLM mode: disabled; not needed by the guided workflow ---
LLM_API_KEY=
TASTEATLAS_LLM_ENABLED=0
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- App ---
PORT=8000

# --- Controlled deployment (host private environment, not a committed .env) ---
# Use a 32-128 character access code: A-Z, a-z, 0-9, underscore, hyphen.
TASTEATLAS_REVIEW_ACCESS_CODE=
# Absolute private persistent directory containing the EXISTING guided.sqlite.
# The controlled factory refuses a missing ledger or any cap other than 12.
TASTEATLAS_STATE_DIR=
TASTEATLAS_QLOO_CALL_LIMIT=12
# Optional PostgreSQL alternative for hosts with ephemeral local filesystems.
# Private secret store only. Existing consumed ledger must be transferred first.
# Runtime NEVER initializes an empty database. TLS verification is mandatory.
TASTEATLAS_DATABASE_URL=
